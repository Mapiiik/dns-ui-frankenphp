# PostgreSQL of the DNS UI, [database] in config.ini uses the same values (host "database")
POSTGRES_DB=dnsui
POSTGRES_USER=dnsui
POSTGRES_PASSWORD=change-me

# Optional: Caddy / FrankenPHP server name (Required for automatic ACME/HTTPS)
# SERVER_NAME=your.domain.example

# Only for compose.production-build.yaml: Opera DNS UI commit or branch
# DNSUI_COMMIT=master

# Where the configuration lives (config.ini and users.caddy, the database has its own Docker volume)
#DATA_DIR=./data

# Behind a proxy that routes TLS by SNI and sends the PROXY protocol (e.g. HAProxy send-proxy-v2):
# LISTENER_MODE=behind-proxy and the proxy's network, where the PROXY header is trusted from.
# Without a proxy only this machine is trusted.
#LISTENER_MODE=direct
#PROXY_ALLOW=172.16.0.0/12

# Mail server for the notifications of the DNS UI (STARTTLS on port 25 by default).
# Without it mail() fails, so set [email] enabled = 0 in config.ini.
#SMTP_HOST=mail.example.com
#SMTP_PORT=25

# Time zone of the dates in the change log (the session time zone of PostgreSQL), UTC by default
#PGTZ=Europe/Prague
