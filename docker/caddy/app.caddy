# What belongs to this application, imported by the Caddyfile, which is the same in every image.

# FrankenPHP's own defaults: classic mode, threads by the number of CPUs
(app_frankenphp) {
}

# Every request needs a login, the DNS UI takes the user name from it
(app_site) {
	basic_auth {
		import users.caddy
	}
}

# The DNS UI routes every page through init.php
(app_php_server) {
	index init.php
}
